# Copy to .env.local for local development. Nothing here is required to run.

# Where the embedded Postgres (PGlite) keeps its files. Default: ./data/pgdata
# If the project lives inside OneDrive, Dropbox or similar, point this somewhere
# unsynced (e.g. C:\Users\you\AppData\Local\PartyHarbor\pgdata): sync clients
# lock files and Postgres then fails with "could not create lock file".
# PGLITE_DATA_DIR=./data/pgdata

# Where uploaded photos are stored (processed copies only). Default: ./data/uploads
# Same advice as the database: keep it out of synced folders.
# UPLOAD_DIR=./data/uploads
# Photos allowed per event before uploads are refused. Default: 500
# GALLERY_MAX_PHOTOS=500

# Password given to the two seeded host accounts on first start. Default: harbor-dev
# SEED_HOST_PASSWORD=harbor-dev

# Public base URL used when building guest invitation links. Defaults to the request origin.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Messaging -------------------------------------------------------------
# "log" (default) writes outgoing texts to the server log. "twilio" sends them.
# MESSAGING_PROVIDER=log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15555550100
# Public URL Twilio posts inbound SMS to (STOP/START handling), used to verify signatures.
# TWILIO_WEBHOOK_URL=https://app.example.com/api/sms/inbound

# Shared secret for an external scheduler calling /api/cron/dispatch.
# CRON_SECRET=
# Set to "off" to stop the in-process once-a-minute dispatcher (e.g. on serverless hosts).
# MESSAGING_HEARTBEAT=on

# 64 hex characters. Encrypts invite tokens at rest so links can be resent.
# Generated automatically next to the database folder when unset (local only).
# INVITE_TOKEN_KEY=
