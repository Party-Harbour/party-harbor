# Copy to .env.local for local development. Nothing here is required to run.

# Where the embedded Postgres (PGlite) keeps its files. Default: ./data/pgdata
# If the project lives inside OneDrive, Dropbox or similar, point this somewhere
# unsynced (e.g. C:\Users\you\AppData\Local\PartyHarbor\pgdata): sync clients
# lock files and Postgres then fails with "could not create lock file".
# PGLITE_DATA_DIR=./data/pgdata

# Where uploaded photos are stored (processed copies only). Default: ./data/uploads
# Same advice as the database: keep it out of synced folders.
# UPLOAD_DIR=./data/uploads
# Photos allowed per event before uploads are refused. Default: 500
# GALLERY_MAX_PHOTOS=500

# --- Host accounts ----------------------------------------------------------
# Hosts created when the database is empty: "Name <email>, Name <email>" (one to six).
# The emails are sign-in names only. Default: two sample hosts.
# SEED_HOSTS="Alex <alex@example.com>, Sam <sam@example.com>"
# Password those seeded hosts start with. Default locally: harbor-dev
# A hosted database only seeds hosts when this is set, and needs 12+ characters.
# SEED_HOST_PASSWORD=harbor-dev

# Opens the /signup page to anyone who knows this code (8+ characters).
# Every host can see every guest list, so only share it with hosts.
# Unset = sign-up closed.
# HOST_SIGNUP_CODE=

# Public base URL used when building guest invitation links. Defaults to the request origin.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Messaging -------------------------------------------------------------
# "log" (default) writes outgoing texts to the server log. "twilio" sends them.
# MESSAGING_PROVIDER=log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15555550100
# Public URL Twilio posts inbound SMS to (STOP/START handling), used to verify signatures.
# TWILIO_WEBHOOK_URL=https://app.example.com/api/sms/inbound

# Shared secret for an external scheduler calling /api/cron/dispatch.
# CRON_SECRET=
# Set to "off" to stop the in-process once-a-minute dispatcher (e.g. on serverless hosts).
# MESSAGING_HEARTBEAT=on

# 64 hex characters. Encrypts invite tokens at rest so links can be resent.
# Generated automatically next to the database folder when unset (local only).
# Required whenever DATABASE_URL is set.
# INVITE_TOKEN_KEY=

# --- Hosting (see docs/hosting.md) -----------------------------------------
# Leave all of these unset for local development with the embedded database.
# Set them in your host's environment settings, not in a committed file.

# A real Postgres instead of the embedded one. For Supabase use the
# "Transaction pooler" connection string (port 6543).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# Connections per server instance. Default: 5
# DATABASE_POOL_MAX=5

# Photos go to a private Supabase Storage bucket when the secret key is set.
# The secret key (sb_secret_...) is server-side only. SUPABASE_SERVICE_ROLE_KEY also works.
# SUPABASE_SECRET_KEY=
# Only needed if DATABASE_URL is not a Supabase URL: the project URL is otherwise read from it.
# SUPABASE_URL=https://<project-ref>.supabase.co
# Bucket name, created on first upload. Default: party-photos
# SUPABASE_STORAGE_BUCKET=party-photos
